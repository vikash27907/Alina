# Copy to .env and change every value before launch.

# SQLite for development. For production switch to PostgreSQL, e.g.
# DATABASE_URL="postgresql://user:pass@host:5432/funwithu"
DATABASE_URL="file:./dev.db"

# Secret used to sign auth tokens (JWT). Use a long random string in production.
AUTH_SECRET="change-me-to-a-long-random-string"

# Seeded admin account (created by `npm run seed`)
ADMIN_EMAIL="admin@funwithu.in"
ADMIN_PASSWORD="change-me"

# Port for the app (Next.js + Socket.IO run on the same port)
PORT=3000
