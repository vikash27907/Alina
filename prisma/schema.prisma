generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  password       String
  name           String
  role           String        @default("CUSTOMER") // CUSTOMER | MODEL | ADMIN
  status         String        @default("ACTIVE") // ACTIVE | SUSPENDED | BANNED
  suspendedUntil DateTime?
  coins          Int           @default(30) // free trial coins on signup
  createdAt      DateTime      @default(now())
  modelProfile   ModelProfile?
  transactions   Transaction[]
  customerCalls  Call[]        @relation("CustomerCalls")
  reportsMade    Report[]      @relation("Reporter")
  reportsAgainst Report[]      @relation("Reported")
  blocksMade     Block[]       @relation("Blocker")
  blocksAgainst  Block[]       @relation("Blocked")
  supportTickets SupportTicket[]
}

model Report {
  id         String    @id @default(cuid())
  reporterId String
  reporter   User      @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedId String
  reported   User      @relation("Reported", fields: [reportedId], references: [id], onDelete: Cascade)
  callId     String    @default("")
  reason     String
  detail     String    @default("")
  status     String    @default("OPEN") // OPEN | ACTIONED | DISMISSED
  resolution String    @default("")
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model SupportTicket {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  status    String           @default("OPEN") // OPEN | ANSWERED | CLOSED
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  messages  SupportMessage[]
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromAdmin Boolean       @default(false)
  text      String
  createdAt DateTime      @default(now())
}

model ModelProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       String   @default("PENDING") // PENDING | APPROVED | REJECTED
  country      String
  dob          String
  languages    String
  bio          String   @default("")
  idDocPath    String
  selfiePath   String
  earnings     Int      @default(0) // lifetime earnings, in ₹
  balance      Int      @default(0) // withdrawable balance, in ₹
  payoutFrozen Boolean  @default(false)
  totalMinutes Int      @default(0)
  rating       Float    @default(5)
  createdAt    DateTime @default(now())
  reviewedAt   DateTime?
  rejectReason String?
  payouts      Payout[]
  calls        Call[]   @relation("ModelCalls")
}

model Transaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // TRIAL | PURCHASE | CALL_SPEND | GIFT_SPEND | EARNING | GIFT_EARNING
  coins     Int      // positive = credit, negative = debit (customer coins or model ₹)
  meta      String   @default("")
  createdAt DateTime @default(now())
}

model Call {
  id         String    @id @default(cuid())
  customerId String
  customer   User      @relation("CustomerCalls", fields: [customerId], references: [id], onDelete: Cascade)
  modelId    String
  model      ModelProfile @relation("ModelCalls", fields: [modelId], references: [id], onDelete: Cascade)
  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  seconds    Int       @default(0)
  coinsSpent Int       @default(0)
  modelEarn  Int       @default(0)
  endReason  String    @default("")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String   // user id, or "anonymous" for failed logins
  action    String   // ADMIN_LOGIN | ADMIN_LOGIN_FAILED | MODEL_APPROVED | MODEL_REJECTED | PAYOUT_PAID | PAYOUT_REJECTED | ...
  target    String   @default("") // affected entity id / email
  detail    String   @default("")
  ip        String   @default("")
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
}

model Payout {
  id             String       @id @default(cuid())
  modelProfileId String
  modelProfile   ModelProfile @relation(fields: [modelProfileId], references: [id], onDelete: Cascade)
  amount         Int          // ₹
  method         String       // UPI | BANK | PAYPAL | CRYPTO
  details        String       // UPI id / account info given by the model
  status         String       @default("PENDING") // PENDING | PAID | REJECTED
  createdAt      DateTime     @default(now())
  processedAt    DateTime?
}
